ANTHROPIC_API_KEY=

# Optional. IANA timezone name used to interpret cron expressions in
# entity/SCHEDULE.md and to display next-fire times in the UI. Stored
# timestamps remain UTC. Defaults to UTC if unset.
# SCHEDULER_TIMEZONE=America/Chicago

# Web frontend (used by `ci serve`).
# Generate WEB_PASSWORD_HASH with: uv run python -m harness.web.auth hash <password>
WEB_PASSWORD_HASH=
# Used to sign session cookies. Any long random string. If unset, a random
# secret is generated per process — sessions will not survive a restart.
WEB_SESSION_SECRET=
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
